+};
+
+// 触摸事件处理
+if let Ok(event) = touch_rx.try_recv() {
+    match event {
+        TouchEvent::Start => {
+            touch_boost.on_touch_start();
+            idle_dive.on_touch_fast_exit();
+        }
+        TouchEvent::End => touch_boost.on_touch_end(),
