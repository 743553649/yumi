<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 卡片物理立影 (Drop Shadow Layer: X=0dp, Y=4dp, Blur=12dp) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- 2. Layer 2 Tint Overlay (10% 暗调) & Layer 3 Fresnel 渐变高光 Stroke -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <solid android:color="@color/ios_glass_card_bg" />
            <stroke
                android:width="1.2dp"
                android:color="@color/ios_glass_stroke_default" />
        </shape>
    </item>
</layer-list>
