<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 激活选中态: 魅红外发光描边 (Section 4.1) -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#40000000" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="21dp" />
                    <solid android:color="@color/ios_mode_fast_glass" />
                    <stroke android:width="1.8dp" android:color="@color/ios_mode_fast_glow" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 默认常规态 -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#40000000" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="21dp" />
                    <solid android:color="@color/ios_glass_card_bg" />
                    <stroke android:width="1.2dp" android:color="@color/ios_glass_stroke_default" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
