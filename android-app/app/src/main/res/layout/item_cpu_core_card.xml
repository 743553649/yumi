<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ios_glass_input"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 核心名称 -->
    <TextView
        android:id="@+id/tvCpuName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPU0"
        android:textColor="@color/ios_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 环形进度图 (显示 0-100%) -->
    <com.yumi.bridge.ui.CpuCircleProgressView
        android:id="@+id/circleProgress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginVertical="6dp" />

    <!-- 频率文本 (如 1152MHz) -->
    <TextView
        android:id="@+id/tvCpuFreq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- MHz"
        android:textColor="@color/ios_text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
