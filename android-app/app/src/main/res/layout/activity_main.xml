<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ios_backdrop">

    <!-- 页面内容主滚动区 (为底部导航栏留出 80dp 避让) -->
    <FrameLayout
        android:id="@+id/mainTabHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp">

        <!-- ==================== Tab 1: 首页 (Home) ==================== -->
        <FrameLayout
            android:id="@+id/tabHomeContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeHomeHost"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- ==================== Tab 2: 日志 (Logs) 独占全屏页面 ==================== -->
        <LinearLayout
            android:id="@+id/tabLogsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <com.yumi.bridge.ui.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ios_glass_card">

                <FrameLayout
                    android:id="@+id/cardTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!-- 终端标题与按键 Header -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="@string/section_terminal"
                                android:textColor="@color/ios_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnClearLog"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_ios_btn_secondary"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="@string/btn_clear_log"
                                android:textColor="@color/ios_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- 5 级日志过滤 Chip 栏 -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/btnLevelAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_ios_btn_blue"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/log_level_all"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/btnLevelDebug"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_ios_btn_secondary"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/log_level_debug"
                                    android:textColor="@color/ios_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/btnLevelInfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_ios_btn_secondary"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/log_level_info"
                                    android:textColor="@color/ios_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/btnLevelWarn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_ios_btn_secondary"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/log_level_warn"
                                    android:textColor="@color/ios_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/btnLevelError"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_ios_btn_secondary"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="@string/log_level_error"
                                    android:textColor="@color/ios_text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- 日志内容滚动与羽化淡出 -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <ScrollView
                                android:id="@+id/svLogScroll"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_ios_glass_input"
                                android:overScrollMode="always"
                                android:padding="12dp"
                                android:scrollbars="vertical">

                                <TextView
                                    android:id="@+id/tvLog"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:lineSpacingExtra="4dp"
                                    android:textColor="@color/ios_terminal_text"
                                    android:textSize="12sp" />
                            </ScrollView>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="16dp"
                                android:layout_alignParentTop="true"
                                android:background="@drawable/bg_terminal_mask_top" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="16dp"
                                android:layout_alignParentBottom="true"
                                android:background="@drawable/bg_terminal_mask_bottom" />
                        </RelativeLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.yumi.bridge.ui.GlassCardView>
        </LinearLayout>

        <!-- ==================== Tab 3: 应用 (Apps) 规则管理页面 ==================== -->
        <LinearLayout
            android:id="@+id/tabAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <!-- 1. Header 卡片 -->
            <com.yumi.bridge.ui.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_ios_glass_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_rules_title"
                        android:textColor="@color/ios_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/app_rules_subtitle"
                        android:textColor="@color/ios_text_secondary"
                        android:textSize="12sp" />

                    <!-- 搜索框 -->
                    <EditText
                        android:id="@+id/etSearchApp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_ios_glass_input"
                        android:hint="@string/search_apps_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/ios_text_primary"
                        android:textColorHint="@color/ios_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.yumi.bridge.ui.GlassCardView>

            <!-- 2. 应用规则列表 -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llAppsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- ==================== 底部 iOS 冰粹毛玻璃胶囊导航栏 ==================== -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/bottomNavLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ios_bottom_nav"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Tab 1: 首页 -->
            <LinearLayout
                android:id="@+id/btnTabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTabHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    android:id="@+id/tvTabHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_home"
                    android:textColor="@color/ios_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 2: 日志 -->
            <LinearLayout
                android:id="@+id/btnTabLogs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTabLogs"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_logs" />

                <TextView
                    android:id="@+id/tvTabLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_logs"
                    android:textColor="@color/ios_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 3: 应用 -->
            <LinearLayout
                android:id="@+id/btnTabApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTabApps"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_apps" />

                <TextView
                    android:id="@+id/tvTabApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_apps"
                    android:textColor="@color/ios_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
